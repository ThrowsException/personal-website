---
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/date';
import { getPosts } from '../lib/posts';
import { blogs, posts as savedPosts, videos } from '../data/links';

const entries = await getPosts();

const groups = [
  { heading: 'Blogs I keep going back to', links: blogs },
  { heading: 'Posts worth re-reading', links: savedPosts },
  { heading: 'Talks', links: videos },
];
---

<Base
  title="Chester O'Neill"
  description="Chester O'Neill — software engineer at QuotaPath, mostly writing Python and React."
  home
>
  <header slot="band" class="band band--home">
    <div class="band-inner">
      <h1>Chester O'Neill</h1>
      <p class="tagline">It&rsquo;s not much, but it&rsquo;s mine.</p>
    </div>
  </header>

  <ol class="index">
    {
      entries.map((entry) => (
        <li>
          <time datetime={entry.data.date.toISOString()}>
            {formatDate(entry.data.date)}
          </time>
          <h2>
            <a href={`/${entry.id}/`}>{entry.data.title}</a>
            {entry.data.draft && <span class="draft">draft</span>}
          </h2>
          <p>{entry.data.description}</p>
        </li>
      ))
    }
  </ol>

  <section class="about">
    <p>
      Fifteen years of building web applications, data pipelines and batch
      systems. These days I&rsquo;m at{' '}
      <a href="https://www.quotapath.com/">QuotaPath</a>, mostly writing Python
      and React.
    </p>
    <ul class="nav">
      <li><a href="/github/">Projects</a></li>
      <li><a href="https://github.com/ThrowsException">GitHub</a></li>
      <li>
        <a href="https://www.linkedin.com/in/throwsexception">LinkedIn</a>
      </li>
    </ul>
  </section>

  <div class="collections">
    {
      groups.map((group) => (
        <section>
          <h2 class="rubric">{group.heading}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .band h1 {
    margin: 0;
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.75rem);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0.4rem 0 0;
    color: var(--on-purple-muted);
    font-style: italic;
    font-size: 1.125rem;
  }

  .index {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }

  .index li + li {
    margin-top: 2rem;
  }

  .index time {
    display: block;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .index h2 {
    margin: 0.15rem 0 0.1rem;
    font-size: 1.375rem;
    font-variation-settings: 'opsz' 36;
  }

  .draft {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    font-style: italic;
    color: var(--muted);
    vertical-align: 0.15em;
  }

  .index p {
    margin: 0;
    max-width: var(--measure);
    color: var(--muted);
  }

  .about {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .about p {
    margin: 0;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .nav a:visited {
    color: var(--link);
  }

  .collections {
    display: grid;
    gap: 2.5rem 3rem;
    align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .rubric {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 12;
    color: var(--muted);
  }

  .collections ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .collections li + li {
    margin-top: 0.45rem;
  }
</style>
